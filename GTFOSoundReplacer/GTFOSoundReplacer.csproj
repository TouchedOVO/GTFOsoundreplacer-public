<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    GTFOSoundReplacer — BepInEx 6 (IL2CPP) plugin for GTFO.
    Target runtime: CoreCLR 6.0.7 (BepInEx 6) => TargetFramework=net6.0.

    Build environment note (see docs/TECH_DESIGN.md):
      * No .NET SDK is installed, but MSBuild (VS2022) + Roslyn csc are available.
      * We therefore use a LEGACY (non-SDK) csproj and reference the CoreCLR
        implementation assemblies directly from the .NET 6 shared framework,
        plus the BepInEx core / interop assemblies via HintPath.
      * NoStdLib=true suppresses the implicit .NET Framework mscorlib; we add
        System.Private.CoreLib (corelib) + mscorlib + System.Runtime facades.
  -->
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <ProjectGuid>{9E1F2A3B-4C5D-4E6F-8A7B-6C5D4E3F2A1B}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>GTFOSoundReplacer</RootNamespace>
    <AssemblyName>GTFOSoundReplacer</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>
    <WarningLevel>4</WarningLevel>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>

    <!--
      NoStdLib + FrameworkPathOverride:
      - NoStdLib=true: do not auto-reference the .NET Framework mscorlib.
      - FrameworkPathOverride points GetReferenceAssemblyPaths at the .NET 6
        shared framework (which contains an mscorlib facade), so the legacy
        MSBuild framework-reference resolution does not fail (MSB3644).
    -->
    <NoStdLib>true</NoStdLib>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <!-- Do not emit the auto-generated .NET Framework 4.7.2 TargetFrameworkAttribute;
         this is a net6.0 (CoreCLR) plugin, the TFM attribute would only be misleading. -->
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>

    <!-- Overridable path defaults (build.ps1 passes explicit values). -->
    <GTFO Condition="'$(GTFO)' == ''">$(GTFO_GAME_PATH)</GTFO>
    <BepInEx Condition="'$(BepInEx)' == ''">$(GTFO)\BepInEx</BepInEx>
    <Net6Framework Condition="'$(Net6Framework)' == ''">$(NET6_FRAMEWORK_PATH)</Net6Framework>
    <FrameworkPathOverride>$(Net6Framework)</FrameworkPathOverride>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>false</Optimize>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- ===================== .NET 6 BCL (CoreCLR shared framework) ===================== -->
    <Reference Include="System.Private.CoreLib">
      <HintPath>$(Net6Framework)\System.Private.CoreLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="mscorlib">
      <HintPath>$(Net6Framework)\mscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Runtime">
      <HintPath>$(Net6Framework)\System.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Console">
      <HintPath>$(Net6Framework)\System.Console.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Collections.Concurrent">
      <HintPath>$(Net6Framework)\System.Collections.Concurrent.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="netstandard">
      <HintPath>$(Net6Framework)\netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Text.Json">
      <HintPath>$(Net6Framework)\System.Text.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Memory">
      <HintPath>$(Net6Framework)\System.Memory.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- ===================== BepInEx 6 core ===================== -->
    <Reference Include="0Harmony">
      <HintPath>$(BepInEx)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Core">
      <HintPath>$(BepInEx)\core\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(BepInEx)\core\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.Common">
      <HintPath>$(BepInEx)\core\BepInEx.Unity.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(BepInEx)\core\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Common">
      <HintPath>$(BepInEx)\core\Il2CppInterop.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.HarmonySupport">
      <HintPath>$(BepInEx)\core\Il2CppInterop.HarmonySupport.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- ===================== UnityEngine interop stubs ===================== -->
    <Reference Include="UnityEngine">
      <HintPath>$(BepInEx)\interop\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(BepInEx)\interop\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(BepInEx)\interop\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(BepInEx)\interop\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Modules-ASM"><HintPath>$(BepInEx)\interop\Modules-ASM.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="CellSound-ASM">
      <HintPath>$(BepInEx)\interop\CellSound-ASM.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Wwise-ASM">
      <HintPath>$(BepInEx)\interop\Wwise-ASM.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(BepInEx)\interop\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSystem">
      <HintPath>$(BepInEx)\interop\Il2CppSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>

  </ItemGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="Audio\*.cs" />
    <Compile Include="UI\*.cs" Exclude="UI\SoundCatalogData.generated.cs" />
    <Compile Include="Catalog\*.cs" />
    <Compile Include="Presets\*.cs" />
  </ItemGroup>


  <ItemGroup>
    <Reference Include="System.Collections"><HintPath>$(Net6Framework)\System.Collections.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Security.Cryptography.Algorithms"><HintPath>$(Net6Framework)\System.Security.Cryptography.Algorithms.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Security.Cryptography.Primitives"><HintPath>$(Net6Framework)\System.Security.Cryptography.Primitives.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Net.Http"><HintPath>$(Net6Framework)\System.Net.Http.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Threading"><HintPath>$(Net6Framework)\System.Threading.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup><Reference Include="System.Private.Uri"><HintPath>$(Net6Framework)\System.Private.Uri.dll</HintPath><Private>false</Private></Reference></ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
